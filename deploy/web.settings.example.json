{
  "USB_RUNTIME_MODE": "azure",
  "ENTRA_TENANT_ID": "<tenant-id>",
  "USB_ONELAKE_WORKSPACE_ID": "<workspace-id>",
  "USB_ONELAKE_LAKEHOUSE_ID": "<lakehouse-id>",
  "USB_ONELAKE_PREFIX": "usb-operations",
  "USB_AUTH_MODE": "entra",
  "ENTRA_CLIENT_ID": "<web-client-id>",
