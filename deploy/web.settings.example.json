  "USB_FUNCTION_SCOPE": "api://<api-client-id>/USB.Access",
  "USB_SESSION_ENCRYPTION_KEY": "@Microsoft.KeyVault(SecretUri=https://<vault-name>.vault.azure.net/secrets/<session-key>/)",
